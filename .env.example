# Copy this file to a new file named ".env" (no ".example" at the end)
# and fill in your own values. The real .env file is listed in .gitignore
# so it will never be committed to Git or uploaded to GitHub.

# Your ESPN league ID. Find it in the URL when you view your league on
# espn.com, e.g. https://fantasy.espn.com/football/league?leagueId=1234567
# means LEAGUE_ID=1234567
LEAGUE_ID=

# Only required for PRIVATE leagues. Public leagues can leave these blank.
# See README.md for exact instructions on how to find SWID and ESPN_S2
# using your browser's cookies.
SWID=
ESPN_S2=

# Only required for the dashboard's "Ask the League" chat tab.
# Get a key at https://console.anthropic.com (see README.md).
ANTHROPIC_API_KEY=
